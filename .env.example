# Copy this file to .env in the project root.
PORT=3001
# Local development credentials only; match these to your PostgreSQL installation.
DATABASE_URL=postgresql://sweety:sweety-local@localhost:5432/sweety
TEST_DATABASE_URL=postgresql://sweety:sweety-local@localhost:5432/sweety_test
# Generate a random secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-authentication
